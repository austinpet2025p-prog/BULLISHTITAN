# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Authentication & Firestore Placeholders
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Payment Gateway Public Keys (Stripe / Paystack / Flutterwave)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_stripe_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_replace_with_paystack_key"
VITE_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-replace-with-flutterwave-key"

# Analytics Placeholder
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Maps Platform API Key
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
