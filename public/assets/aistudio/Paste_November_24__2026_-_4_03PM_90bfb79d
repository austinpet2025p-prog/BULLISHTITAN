<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bullish Titan | Trading Academy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">

<style>
:root { --gold:#F5C542; --gold-light:#FFE9A6; --gold-dark:#8A5E12; }
* { box-sizing:border-box; margin:0; padding:0; }
html, body { background:#000; }
body { font-family:'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif; color:#fff; }

/* ---------- Hero ---------- */
.hero {
  position:relative; width:100%; height:100vh; height:100svh; min-height:560px;
  overflow:hidden; isolation:isolate;
  background:radial-gradient(ellipse at 50% 65%, #0c1c38 0%, #060d1c 50%, #000 100%);
}
.stage { position:absolute; inset:0; transform-origin:50% 55%; will-change:transform; }
#fx, #sparks { position:absolute; inset:0; width:100%; height:100%; display:block; }
#fx { z-index:1; }
#sparks { z-index:4; pointer-events:none; }

/* ---------- Bull + titan ---------- */
.bull {
  position:absolute; left:50%; bottom:-2%; width:min(68vmin, 620px); z-index:2; opacity:0;
  filter:drop-shadow(0 0 28px rgba(245,197,66,.45));
  -webkit-mask-image:linear-gradient(to top, transparent 0%, #000 38%);
          mask-image:linear-gradient(to top, transparent 0%, #000 38%);
  will-change:transform, opacity;
}

/* ---------- Holographic panels ---------- */
.holo-layer { position:absolute; inset:0; z-index:3; perspective:800px; pointer-events:none; }
.holo-world { position:absolute; inset:0; transform-style:preserve-3d; will-change:transform; }
.holo-panel { position:absolute; left:50%; top:50%; opacity:0; will-change:transform, opacity; }
.holo-card {
  position:relative; min-width:150px; padding:10px 14px; border-radius:10px;
  font-family:'Courier New', ui-monospace, monospace; color:var(--gold-light);
  background:linear-gradient(135deg, rgba(60,160,255,.16), rgba(245,197,66,.07));
  border:1px solid rgba(245,197,66,.38);
  box-shadow:0 0 26px rgba(245,197,66,.16), inset 0 0 18px rgba(80,170,255,.10);
  backdrop-filter:blur(2px); animation:bob 5s ease-in-out infinite; overflow:hidden;
}
.holo-card::after {
  content:""; position:absolute; inset:0; pointer-events:none;
  background:repeating-linear-gradient(to bottom, rgba(255,255,255,.05) 0 1px, transparent 1px 3px);
}
.holo-card .row { display:flex; justify-content:space-between; gap:14px; font-size:12px; }
.holo-card .sym { letter-spacing:.08em; opacity:.9; }
.holo-card .px  { font-size:15px; margin-top:4px; }
.holo-card svg  { display:block; width:100%; height:38px; margin-top:6px; }
.holo-card svg polyline { fill:none; stroke:#FFE08A; stroke-width:1.6; filter:drop-shadow(0 0 4px rgba(245,197,66,.8)); }
.holo-card.tick { display:flex; align-items:baseline; gap:12px; min-width:0; padding:8px 14px; font-size:13px; }
.holo-card.tick .px { margin-top:0; }
.up { color:#6dffb5; } .down { color:#ff7b7b; }
@keyframes bob { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-9px); } }

/* ---------- Overlays ---------- */
.vignette {
  position:absolute; inset:0; z-index:5; pointer-events:none;
  background:radial-gradient(ellipse at center, transparent 45%, rgba(0,0,0,.75) 100%);
}
.grain {
  position:absolute; inset:-50%; z-index:5; pointer-events:none; opacity:.09; mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.6'/></svg>");
  animation:grain .7s steps(6) infinite;
}
@keyframes grain {
  0% { transform:translate(0,0); } 20% { transform:translate(-4%,3%); } 40% { transform:translate(3%,-5%); }
  60% { transform:translate(-5%,-2%); } 80% { transform:translate(4%,4%); } 100% { transform:translate(0,0); }
}
.flash {
  position:absolute; inset:0; z-index:6; opacity:0; pointer-events:none; mix-blend-mode:screen;
  background:radial-gradient(circle at 50% 40%, rgba(255,233,166,.95) 0%, rgba(245,197,66,.35) 30%, transparent 62%);
}
.bar { position:absolute; left:0; width:100%; height:9%; background:#000; z-index:9; pointer-events:none; }
.bar.top { top:0; transform-origin:50% 0; }
.bar.bottom { bottom:0; transform-origin:50% 100%; }

/* ---------- Logo ---------- */
.logo-wrap { position:absolute; left:50%; top:40%; z-index:7; opacity:0; will-change:transform, opacity, filter; }
.logo-inner { position:relative; animation:glow 3.4s ease-in-out infinite; }
#logo { display:block; width:min(46vw, 380px); height:auto; }
.logo-shine {
  position:absolute; inset:0; pointer-events:none; mix-blend-mode:screen;
  background:linear-gradient(115deg, transparent 35%, rgba(255,255,255,.95) 50%, transparent 65%);
  background-size:250% 100%; background-position:180% 0;
  -webkit-mask-size:100% 100%; mask-size:100% 100%;
  -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat;
}
.logo-fallback { display:none; text-align:center; font-family:'Cinzel', Georgia, serif; font-weight:800; letter-spacing:.12em; }
.logo-fallback span {
  display:block; font-size:clamp(2rem, 6.5vw, 4.4rem);
  background:linear-gradient(180deg, var(--gold-light), var(--gold) 55%, var(--gold-dark));
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.logo-fallback small { display:block; margin-top:6px; font-size:clamp(.7rem, 1.6vw, 1rem); letter-spacing:.5em; color:var(--gold-light); opacity:.8; }
@keyframes glow {
  0%,100% { filter:drop-shadow(0 0 12px rgba(245,197,66,.55)) drop-shadow(0 0 38px rgba(245,197,66,.25)); }
  50%     { filter:drop-shadow(0 0 20px rgba(245,197,66,.8))  drop-shadow(0 0 60px rgba(245,197,66,.38)); }
}

/* ---------- Headline ---------- */
.hero-content {
  position:absolute; left:50%; bottom:11%; z-index:8; width:min(90vw, 820px);
  text-align:center; opacity:0; pointer-events:none;
}
.hero-content h1 {
  font-family:'Cinzel', Georgia, serif; font-size:clamp(1.7rem, 4.6vw, 3.4rem); line-height:1.15;
  color:var(--gold-light); text-shadow:0 0 26px rgba(245,197,66,.45); perspective:600px;
}
.word { display:inline-block; white-space:nowrap; }
.char { display:inline-block; will-change:transform, opacity; }
.hero-content p {
  margin:14px auto 26px; max-width:560px; font-size:clamp(.9rem, 1.7vw, 1.1rem);
  color:rgba(255,255,255,.78); line-height:1.6;
}
.cta {
  display:inline-block; padding:14px 34px; border-radius:999px; font-weight:600; letter-spacing:.06em;
  text-decoration:none; color:#1a1203; background:linear-gradient(180deg, var(--gold-light), var(--gold));
  box-shadow:0 0 28px rgba(245,197,66,.45); will-change:transform;
}

/* ---------- Skip / Replay ---------- */
.replay {
  position:absolute; top:calc(9% + 12px); right:18px; z-index:10; padding:8px 16px; border-radius:999px;
  border:1px solid rgba(245,197,66,.45); background:rgba(0,0,0,.35); color:var(--gold-light);
  font:600 12px 'Montserrat', system-ui, sans-serif; letter-spacing:.08em; cursor:pointer; backdrop-filter:blur(4px);
}
.replay:hover { background:rgba(245,197,66,.18); }

@media (prefers-reduced-motion: reduce) { .holo-card, .logo-inner, .grain { animation:none; } }
</style>
</head>

<body>

<section class="hero" id="hero" aria-label="Bullish Titan Trading Academy">

  <div class="stage" id="stage">
    <canvas id="fx"></canvas>

    <svg class="bull" id="bull" viewBox="0 0 400 360" aria-hidden="true">
      <defs>
