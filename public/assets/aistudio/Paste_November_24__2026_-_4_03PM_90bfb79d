      <path d="M272 118 C330 112 362 70 348 14 C330 58 302 80 260 90 Z" fill="url(#gold)"/>
      <path d="M132 108 L84 112 L98 140 L134 134 Z" fill="url(#gold)"/>
      <path d="M268 108 L316 112 L302 140 L266 134 Z" fill="url(#gold)"/>
      <path d="M135 92 L265 92 C292 130 276 196 244 244 C228 270 216 286 200 290 C184 286 172 270 156 244 C124 196 108 130 135 92 Z" fill="url(#gold)"/>
      <ellipse cx="200" cy="262" rx="34" ry="20" fill="#9a6d16" opacity=".55"/>
      <ellipse cx="172" cy="150" rx="11" ry="3.2" fill="#fff7d1" transform="rotate(14 172 150)"/>
      <ellipse cx="228" cy="150" rx="11" ry="3.2" fill="#fff7d1" transform="rotate(-14 228 150)"/>
